                    Show-FloatingBar
                    $catalog = Invoke-FileCodeAllotment -TargetDirectory $Path -CatalogPath "file_catalog.json"
                    Write-Host ""
                    Write-Host "   Press ENTER to return to dashboard..." -ForegroundColor Cyan
                    [void](Read-Host)
                }
                '8' {
