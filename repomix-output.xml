    assert.strictEqual(worldPos.y, 10);
    assert.strictEqual(worldPos.z, -2050);
    
    // Test World -> Local
    const backToLocal = sector.toLocalPosition(worldPos);
    assert.deepStrictEqual(backToLocal, localEntityPos);
});
