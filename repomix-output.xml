      eventsById.set(event.id, event);
    }
    this._events = eventsById;

    // Restore ready queue
    this._readyQueue.deserialize(data.readyQueue, eventsById);

    // Restore dependency graph
    this._dependencyGraph.deserialize(data.dependencyGraph);
