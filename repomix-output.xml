            upX = up.x;
            upY = up.y;
            upZ = up.z;
        }

        // ---- Compute right = forward × up ----
        let rightX = fwdY * upZ - fwdZ * upY;
        let rightY = fwdZ * upX - fwdX * upZ;
        let rightZ = fwdX * upY - fwdY * upX;

        // ---- Re-normalize right ----
        let rightLenSq = rightX * rightX + rightY * rightY + rightZ * rightZ;
