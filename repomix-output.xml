<file path="DirectoryInspector.ps1">
<#
.SYNOPSIS
    Directory Inspector — Fast, Reliable & Pretty
.DESCRIPTION
    Scans a directory recursively and reports:
    - Empty folders
    - Empty files
    - Files with content (size, lines, extension)
    - Breakdown by extension
    - Summary
.PARAMETER Path
    The directory to scan (defaults to current directory)
.PARAMETER Music
    Path to an MP3 file to play in the background
.PARAMETER NoMusic
    Disables background music
.PARAMETER MaxDisplayRows
    Max rows shown per table on screen before truncating with a "N more" note
    (the exported .txt report always contains the full list).
.NOTES
    Background music runs the WMPlayer COM object on its own dedicated STA
    runspace, so it works regardless of whether the host console itself is
    STA or MTA (Windows PowerShell 5.1 vs. pwsh 7+).
#>

param(
    [string]$Path = (Get-Location).Path,
    [string]$Music,
    [switch]$NoMusic,
    [int]$MaxDisplayRows = 40
)

try { [Console]::OutputEncoding = [System.Text.Encoding]::UTF8 } catch {}

# -----------------------------------------------------------------------------
# VISUAL HELPERS
# -----------------------------------------------------------------------------

function Show-Banner {
    param([string]$Title)
    $width = 80
    $inner = $width - 4
    if ($Title.Length -gt $inner) { $Title = $Title.Substring(0, $inner) }
    $pad = [Math]::Max(0, $inner - $Title.Length)
    $left = [Math]::Floor($pad / 2)
    $right = $pad - $left
    Write-Host ""
    Write-Host ("  +" + ("=" * ($width - 4)) + "+") -ForegroundColor DarkCyan
    Write-Host ("  |" + (" " * $left) + $Title + (" " * $right) + "|") -ForegroundColor Cyan
    Write-Host ("  +" + ("=" * ($width - 4)) + "+") -ForegroundColor DarkCyan
}

function Write-SectionHeader {
    param([string]$Icon, [string]$Title, [string]$Color = 'Cyan')
    Write-Host ""
    Write-Host "  $Icon $Title" -ForegroundColor $Color
    Write-Host ("  " + ("-" * 76)) -ForegroundColor DarkGray
}

function Get-HumanSize {
    param([long]$Bytes)
    if ($Bytes -ge 1GB) { return "{0:N2} GB" -f ($Bytes / 1GB) }
    if ($Bytes -ge 1MB) { return "{0:N2} MB" -f ($Bytes / 1MB) }
    if ($Bytes -ge 1KB) { return "{0:N2} KB" -f ($Bytes / 1KB) }
    return "$Bytes B"
}

function Get-SizeColor {
    param([long]$Bytes)
    if ($Bytes -ge 50MB) { return 'Red' }
    if ($Bytes -ge 5MB)  { return 'Yellow' }
    if ($Bytes -ge 100KB) { return 'Green' }
    return 'DarkGray'
}

function Get-Extension {
    param([string]$FileName)
    $ext = [System.IO.Path]::GetExtension($FileName)
    if ([string]::IsNullOrEmpty($ext)) { return "(none)" }
    return $ext
}

function Get-TruncatedString {
    param([string]$Text, [int]$MaxLength)
    if ($null -eq $Text) { $Text = "" }
    if ($Text.Length -le $MaxLength) { return $Text.PadRight($MaxLength) }
    if ($MaxLength -le 3) { return $Text.Substring(0, $MaxLength) }
    return $Text.Substring(0, $MaxLength - 3) + "..."
}

function Write-BoxTable {
    param(
        [string[]]$Headers,
        [int[]]$Widths,
        [array]$Rows,
        [string]$BorderColor = 'DarkGray',
        [string]$HeaderColor = 'White',
        [string]$RowColor = 'Gray',
        [string[]]$RowColors  # optional, one entry per row - overrides RowColor when present
    )
    $top = "  +" + (($Widths | ForEach-Object { "-" * ($_ + 2) }) -join "+") + "+"
    $mid = "  +" + (($Widths | ForEach-Object { "-" * ($_ + 2) }) -join "+") + "+"
    $bot = "  +" + (($Widths | ForEach-Object { "-" * ($_ + 2) }) -join "+") + "+"

    Write-Host $top -ForegroundColor $BorderColor
    $headerCells = for ($c = 0; $c -lt $Headers.Count; $c++) { " " + (Get-TruncatedString $Headers[$c] $Widths[$c]) + " " }
    Write-Host ("  |" + ($headerCells -join "|") + "|") -ForegroundColor $HeaderColor
    Write-Host $mid -ForegroundColor $BorderColor
    for ($r = 0; $r -lt $Rows.Count; $r++) {
        $row = $Rows[$r]
        $cells = for ($c = 0; $c -lt $row.Count; $c++) { " " + (Get-TruncatedString ([string]$row[$c]) $Widths[$c]) + " " }
        $color = if ($RowColors -and $r -lt $RowColors.Count) { $RowColors[$r] } else { $RowColor }
        Write-Host ("  |" + ($cells -join "|") + "|") -ForegroundColor $color
    }
    Write-Host $bot -ForegroundColor $BorderColor
}

# -----------------------------------------------------------------------------
# FILE ANALYSIS HELPERS
# -----------------------------------------------------------------------------

function Test-BinaryFile {
    # Sample only the first few KB instead of reading the whole file - this is
    # what made scanning huge binaries (video/exe/etc.) so slow before.
    param([string]$FilePath, [int]$SampleSize = 8000)
    try {
        $stream = [System.IO.File]::OpenRead($FilePath)
        try {
            $len = [Math]::Min($SampleSize, $stream.Length)
            if ($len -le 0) { return $false }
            $buffer = New-Object byte[] $len
            $read = $stream.Read($buffer, 0, $len)
            for ($j = 0; $j -lt $read; $j++) {
                if ($buffer[$j] -eq 0) { return $true }
            }
            return $false
        } finally {
            $stream.Dispose()
        }
    } catch {
        return $true
    }
}

function Get-LineCount {
    param([string]$FilePath)
    $lines = 0
    try {
        $stream = [System.IO.File]::OpenRead($FilePath)
        try {
            $reader = New-Object System.IO.StreamReader($stream, [System.Text.Encoding]::UTF8, $true, 65536)
            try {
                while ($null -ne $reader.ReadLine()) { $lines++ }
            } finally {
                $reader.Dispose()
            }
        } finally {
            # stream is disposed via $reader.Dispose()
        }
    } catch {
        return 0
    }
    return $lines
}

# -----------------------------------------------------------------------------
# BACKGROUND MUSIC
# Tries VLC first (headless, no window) since that's commonly installed even
# when Windows Media Player isn't. Falls back to the WMP COM object (on its
# own dedicated STA runspace) only if VLC can't be found.
# -----------------------------------------------------------------------------

$script:musicProcess = $null
$script:musicPS = $null
$script:musicRS = $null

function Find-VlcPath {
    $candidates = @(
        (Join-Path $env:ProgramFiles "VideoLAN\VLC\vlc.exe")
    )
    if (${env:ProgramFiles(x86)}) {
        $candidates += (Join-Path ${env:ProgramFiles(x86)} "VideoLAN\VLC\vlc.exe")
    }
    foreach ($c in $candidates) {
        if ($c -and (Test-Path -LiteralPath $c)) { return $c }
    }
    $cmd = Get-Command 'vlc.exe' -ErrorAction SilentlyContinue
    if (-not $cmd) { $cmd = Get-Command 'vlc' -ErrorAction SilentlyContinue }
    if ($cmd) { return $cmd.Source }
    return $null
}

function Start-BackgroundMusic {
    param([string]$MusicFile)

    if (-not (Test-Path -LiteralPath $MusicFile)) {
        Write-Host "  [WARN] Music file not found: $MusicFile" -ForegroundColor Yellow
        return $false
    }

    $resolved = (Resolve-Path -LiteralPath $MusicFile).Path

    # --- Try 1: VLC, run headless via --intf dummy (no window at all) ------
    $vlcPath = Find-VlcPath
    if ($vlcPath) {
        try {
            $argString = '--intf dummy --loop --no-video-title-show "{0}"' -f $resolved
            $proc = Start-Process -FilePath $vlcPath -ArgumentList $argString -WindowStyle Hidden -PassThru
            $script:musicProcess = $proc
            Write-Host "  [OK] Playing via VLC: $(Split-Path -Leaf $resolved)" -ForegroundColor Green
            return $true
        } catch {
            Write-Host "  [WARN] VLC playback failed, trying another player: $($_.Exception.Message)" -ForegroundColor Yellow
        }
    }

    # --- Try 2: Windows Media Player COM object (needs WMP + an STA thread) -
    try {
        # WMPlayer's COM object needs an STA thread to work reliably. Rather
        # than requiring the caller to launch PowerShell with -sta (pwsh 7+
        # defaults to MTA, which silently breaks it), spin up a dedicated STA
        # runspace just for playback. This works from any host - IF WMP is
        # actually installed, which New-Object -ComObject will fail fast on
        # if it isn't.
        $rs = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspace()
        $rs.ApartmentState = [System.Threading.ApartmentState]::STA
        $rs.ThreadOptions = [System.Management.Automation.Runspaces.PSThreadOptions]::ReuseThread
        $rs.Open()

        $ps = [System.Management.Automation.PowerShell]::Create()
        $ps.Runspace = $rs
        [void]$ps.AddScript({
            param($path)
            $player = New-Object -ComObject WMPlayer.OCX
            $player.settings.autoStart = $true
            $player.settings.volume = 70
            try { $player.settings.setMode('loop', $true) } catch {}
            $player.URL = $path
            $player.controls.play()
            while ($true) { Start-Sleep -Milliseconds 500 }
        }).AddArgument($resolved)

        $handle = $ps.BeginInvoke()
        Start-Sleep -Milliseconds 300
        if ($ps.HadErrors) {
            $msg = ($ps.Streams.Error | Select-Object -First 1 -ExpandProperty Exception).Message
            throw $msg
        }

        $script:musicPS = $ps
        $script:musicRS = $rs
        Write-Host "  [OK] Playing via Windows Media Player: $(Split-Path -Leaf $resolved)" -ForegroundColor Green
        return $true
    } catch {
        Write-Host "  [WARN] No usable media player found (checked VLC and Windows Media Player). Skipping music." -ForegroundColor Yellow
        return $false
    }
}

function Stop-BackgroundMusic {
    if ($script:musicProcess) {
        try {
            if (-not $script:musicProcess.HasExited) { Stop-Process -Id $script:musicProcess.Id -Force -ErrorAction SilentlyContinue }
        } catch {}
        $script:musicProcess = $null
    }
    if ($script:musicPS) {
        try { $script:musicPS.Stop() } catch {}
        try { $script:musicPS.Dispose() } catch {}
        $script:musicPS = $null
    }
    if ($script:musicRS) {
        try { $script:musicRS.Close() } catch {}
        try { $script:musicRS.Dispose() } catch {}
        $script:musicRS = $null
    }
}

# -----------------------------------------------------------------------------
# SCAN FUNCTION
# -----------------------------------------------------------------------------

function Invoke-DirectoryScan {
    param([string]$Root)

    # Normalize once so relative-path math below can never throw, even if the
    # caller passed a path with a trailing slash.
    $rootFull = (Resolve-Path -LiteralPath $Root).Path.TrimEnd('\', '/')

    $stats = @{
        TotalFolders = 0
        EmptyFolders = 0
        TotalFiles   = 0
        EmptyFiles   = 0
        CodeFiles    = 0
        TotalLines   = 0
        SkippedFiles = 0
    }

    $emptyDirs    = [System.Collections.Generic.List[string]]::new()
    $emptyFiles   = [System.Collections.Generic.List[string]]::new()
    $contentFiles = [System.Collections.Generic.List[object]]::new()
    $extCount     = @{}
    $extLines     = @{}

    Write-Host "  [1/2] Enumerating directory tree..." -ForegroundColor Gray

    # Single recursive pass instead of walking the tree twice, plus one extra
    # Get-ChildItem call PER folder just to test emptiness. That per-folder
    # call was the main performance killer on large trees (O(n^2)).
    $allItems = Get-ChildItem -LiteralPath $rootFull -Recurse -Force -ErrorAction SilentlyContinue

    $dirs  = [System.Collections.Generic.List[System.IO.DirectoryInfo]]::new()
    $files = [System.Collections.Generic.List[System.IO.FileInfo]]::new()
    $parentsWithChildren = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)

    foreach ($item in $allItems) {
        if ($item.PSIsContainer) {
            $dirs.Add($item)
            if ($item.Parent) { [void]$parentsWithChildren.Add($item.Parent.FullName) }
        } else {
            $files.Add($item)
            [void]$parentsWithChildren.Add($item.DirectoryName)
        }
    }

    $stats.TotalFolders = $dirs.Count
    foreach ($folder in $dirs) {
        if (-not $parentsWithChildren.Contains($folder.FullName)) {
            $stats.EmptyFolders++
            $rel = $folder.FullName.Substring($rootFull.Length).TrimStart('\', '/')
            $emptyDirs.Add($rel)
        }
    }
    Write-Host "  [OK] Found $($stats.TotalFolders) folders, $($stats.EmptyFolders) empty." -ForegroundColor Green

    Write-Host "  [2/2] Scanning files..." -ForegroundColor Gray

    $stats.TotalFiles = $files.Count
    $total = $files.Count
    $i = 0

    foreach ($file in $files) {
        $i++
        if ($total -gt 0 -and ($i % 25 -eq 0 -or $i -eq $total)) {
            Write-Progress -Activity "Scanning files" -Status "$i / $total" -PercentComplete (([double]$i / $total) * 100)
        }

        $rel = $file.FullName.Substring($rootFull.Length).TrimStart('\', '/')

        if ($file.Length -eq 0) {
            $stats.EmptyFiles++
            $emptyFiles.Add($rel)
            continue
        }

        $stats.CodeFiles++

        # Skip line-counting for binary files and very large files (>25MB) -
        # the old version read every byte of every file one line at a time.
        $lines = 0
        if ((Test-BinaryFile -FilePath $file.FullName) -or $file.Length -gt 25MB) {
            $stats.SkippedFiles++
        } else {
            $lines = Get-LineCount -FilePath $file.FullName
        }
        $stats.TotalLines += $lines

        $ext = Get-Extension -FileName $file.Name
        $extKey = if ($ext -eq "(none)") { "noext" } else { $ext.Substring(1) }

        $contentFiles.Add([PSCustomObject]@{
            Path      = $rel
            Extension = $ext
            Size      = $file.Length
            Lines     = $lines
        })

        if (-not $extCount.ContainsKey($extKey)) {
            $extCount[$extKey] = 0
            $extLines[$extKey] = 0
        }
        $extCount[$extKey]++
        $extLines[$extKey] += $lines
    }

    Write-Progress -Activity "Scanning files" -Completed
    Write-Host "  [OK] Found $($stats.TotalFiles) files, $($stats.CodeFiles) with content ($($stats.SkippedFiles) skipped as binary/large)." -ForegroundColor Green

    return @{
        Stats        = $stats
        EmptyDirs    = $emptyDirs
        EmptyFiles   = $emptyFiles
        ContentFiles = $contentFiles
        ExtCount     = $extCount
        ExtLines     = $extLines
    }
}

# -----------------------------------------------------------------------------
# SHOW REPORT
# -----------------------------------------------------------------------------

function Show-Report {
    param($Result, $Root, [int]$MaxDisplayRows = 40)

    $stats = $Result.Stats

    Show-Banner "SCAN RESULTS"

    # --- Summary -------------------------------------------------------
    Write-SectionHeader ">" "SUMMARY" "Cyan"
    $summaryRows = @(
        @("Folders scanned", $stats.TotalFolders)
        @("Empty folders", $stats.EmptyFolders)
        @("Files scanned", $stats.TotalFiles)
        @("Empty files", $stats.EmptyFiles)
        @("Files with content", $stats.CodeFiles)
        @("Skipped (binary/large)", $stats.SkippedFiles)
        @("Total lines", $stats.TotalLines)
    )
    if ($stats.ContainsKey('ElapsedSeconds')) {
        $summaryRows += , @("Scan duration", ("{0:N2}s" -f $stats.ElapsedSeconds))
    }
    foreach ($row in $summaryRows) {
        Write-Host ("    * {0,-26}" -f $row[0]) -ForegroundColor DarkGray -NoNewline
        Write-Host $row[1] -ForegroundColor White
    }

    # --- Empty folders ---------------------------------------------------
    Write-SectionHeader ">" "EMPTY FOLDERS" "Cyan"
    if ($Result.EmptyDirs.Count -eq 0) {
        Write-Host "    [OK] No empty folders found." -ForegroundColor Green
    } else {
        foreach ($dir in ($Result.EmptyDirs | Select-Object -First $MaxDisplayRows)) {
            Write-Host "    [EMPTY] $dir" -ForegroundColor Red
        }
        if ($Result.EmptyDirs.Count -gt $MaxDisplayRows) {
            Write-Host "    ... and $($Result.EmptyDirs.Count - $MaxDisplayRows) more (full list in exported report)" -ForegroundColor DarkGray
        }
    }

    # --- Empty files -------------------------------------------------------
    Write-SectionHeader ">" "EMPTY FILES" "Cyan"
    if ($Result.EmptyFiles.Count -eq 0) {
        Write-Host "    [OK] No empty files found." -ForegroundColor Green
    } else {
        foreach ($file in ($Result.EmptyFiles | Select-Object -First $MaxDisplayRows)) {
            Write-Host "    [EMPTY] $file" -ForegroundColor Red
        }
        if ($Result.EmptyFiles.Count -gt $MaxDisplayRows) {
            Write-Host "    ... and $($Result.EmptyFiles.Count - $MaxDisplayRows) more (full list in exported report)" -ForegroundColor DarkGray
        }
    }

    # --- Files with content --------------------------------------------
    Write-SectionHeader ">" "FILES WITH CONTENT" "Cyan"
    if ($Result.ContentFiles.Count -eq 0) {
        Write-Host "    No files with content found." -ForegroundColor Yellow
    } else {
        $sorted = $Result.ContentFiles | Sort-Object Path
        $shown = $sorted | Select-Object -First $MaxDisplayRows
        $rows = @()
        $rowColors = @()
        foreach ($f in $shown) {
            $rows += , @($f.Path, $f.Extension, (Get-HumanSize $f.Size), $f.Lines)
            $rowColors += (Get-SizeColor -Bytes $f.Size)
        }
        Write-BoxTable -Headers @("FILE PATH", "EXT", "SIZE", "LINES") -Widths @(48, 10, 10, 7) -Rows $rows -RowColors $rowColors
        if ($sorted.Count -gt $MaxDisplayRows) {
            Write-Host "    ... and $($sorted.Count - $MaxDisplayRows) more files (full list in exported report)" -ForegroundColor DarkGray
        }
    }

    # --- Breakdown by extension ------------------------------------------
    Write-SectionHeader ">" "BREAKDOWN BY EXTENSION" "Cyan"
    if ($Result.ExtCount.Keys.Count -eq 0) {
        Write-Host "    No extension data available." -ForegroundColor Yellow
    } else {
        $keys = $Result.ExtCount.Keys | Sort-Object
        $rows = foreach ($key in $keys) {
            $display = if ($key -eq "noext") { "(none)" } else { ".$key" }
            , @($display, $Result.ExtCount[$key], $Result.ExtLines[$key])
        }
        Write-BoxTable -Headers @("EXTENSION", "FILES", "LINES") -Widths @(14, 8, 10) -Rows $rows -RowColor 'Magenta'
    }

    Write-Host ""
    Write-Host ("  " + ("-" * 76)) -ForegroundColor DarkGray
    Write-Host "  Finished scanning $Root" -ForegroundColor Gray
    Write-Host ""
}

# -----------------------------------------------------------------------------
# EXPORT REPORT (plain text - kept ASCII-only for maximum portability)
# -----------------------------------------------------------------------------

function Export-Report {
    param($Result, $Root)

    $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $outPath = Join-Path (Get-Location).Path "DirectoryReport_$timestamp.txt"

    $lines = [System.Collections.Generic.List[string]]::new()
    $lines.Add("=" * 80)
    $lines.Add("DIRECTORY INSPECTOR REPORT")
    $lines.Add("=" * 80)
    $lines.Add("Root scanned : $Root")
    $lines.Add("Generated    : $(Get-Date)")
    $lines.Add("")
    $lines.Add("SUMMARY")
    $lines.Add("Total folders scanned    : $($Result.Stats.TotalFolders)")
    $lines.Add("Empty folders found      : $($Result.Stats.EmptyFolders)")
    $lines.Add("Total files scanned      : $($Result.Stats.TotalFiles)")
    $lines.Add("Empty files found        : $($Result.Stats.EmptyFiles)")
    $lines.Add("Files with content       : $($Result.Stats.CodeFiles)")
    $lines.Add("Skipped (binary/large)   : $($Result.Stats.SkippedFiles)")
    $lines.Add("Total lines (all files)  : $($Result.Stats.TotalLines)")
    if ($Result.Stats.ContainsKey('ElapsedSeconds')) {
        $lines.Add(("Scan duration            : {0:N2}s" -f $Result.Stats.ElapsedSeconds))
    }
    $lines.Add("")
    $lines.Add("EMPTY FOLDERS")
    if ($Result.EmptyDirs.Count -eq 0) { $lines.Add("  No empty folders found.") }
    else { foreach ($d in $Result.EmptyDirs) { $lines.Add("  [EMPTY DIR] $d") } }
    $lines.Add("")
    $lines.Add("EMPTY FILES")
    if ($Result.EmptyFiles.Count -eq 0) { $lines.Add("  No empty files found.") }
    else { foreach ($f in $Result.EmptyFiles) { $lines.Add("  [EMPTY FILE] $f") } }
    $lines.Add("")
    $lines.Add("FILES WITH CONTENT")
    if ($Result.ContentFiles.Count -eq 0) { $lines.Add("  No files with content found.") }
    else {
        foreach ($file in ($Result.ContentFiles | Sort-Object Path)) {
            $size = Get-HumanSize $file.Size
            $lines.Add("  $($file.Path)  |  ext:$($file.Extension)  |  size:$size  |  lines:$($file.Lines)")
        }
    }
    $lines.Add("")
    $lines.Add("BREAKDOWN BY EXTENSION")
    if ($Result.ExtCount.Keys.Count -eq 0) { $lines.Add("  No extension data.") }
    else {
        foreach ($key in ($Result.ExtCount.Keys | Sort-Object)) {
            $display = if ($key -eq "noext") { "(none)" } else { ".$key" }
            $lines.Add("  $display  -  files: $($Result.ExtCount[$key])   lines: $($Result.ExtLines[$key])")
        }
    }
    $lines.Add("")
    $lines.Add("=" * 80)
    $lines.Add("End of report.")

    $lines | Set-Content -Path $outPath -Encoding UTF8
    Write-Host "  [OK] Report exported to: $outPath" -ForegroundColor Green
    return $outPath
}

# -----------------------------------------------------------------------------
# MAIN
# -----------------------------------------------------------------------------

try {
    Clear-Host

    Show-Banner "DIRECTORY INSPECTOR"

    if (-not (Test-Path -LiteralPath $Path -PathType Container)) {
        Write-Host "  [ERROR] Directory not found: $Path" -ForegroundColor Red
        exit 1
    }

    $Path = (Resolve-Path -LiteralPath $Path).Path
    Write-Host "  Root : $Path" -ForegroundColor Gray

    if ($Music -and -not $NoMusic) {
        Start-BackgroundMusic -MusicFile $Music
    } elseif (-not $NoMusic) {
        $scriptDir = if ($PSScriptRoot) { $PSScriptRoot } elseif ($MyInvocation.MyCommand.Path) { Split-Path -Parent $MyInvocation.MyCommand.Path } else { $null }
        if ($scriptDir) {
            $defaultMusic = Join-Path $scriptDir "bgmusic.mp3"
            if (Test-Path -LiteralPath $defaultMusic) {
                Start-BackgroundMusic -MusicFile $defaultMusic
            }
        }
    }

    Write-Host ""
    Write-Host "  Scanning recursively, please wait..." -ForegroundColor Gray
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $result = Invoke-DirectoryScan -Root $Path
    $sw.Stop()
    $result.Stats.ElapsedSeconds = $sw.Elapsed.TotalSeconds

    Clear-Host
    Show-Report -Result $result -Root $Path -MaxDisplayRows $MaxDisplayRows

    $exportedFile = Export-Report -Result $result -Root $Path

    $menuChoice = $null
    do {
        Show-Banner "OPTIONS"
        Write-Host "    [1] View the report again on screen" -ForegroundColor White
        Write-Host "    [2] Copy the report to clipboard" -ForegroundColor White
        Write-Host "    [3] Export the report as a .txt file (again)" -ForegroundColor White
        Write-Host "    [4] Take a screenshot of this window" -ForegroundColor White
        Write-Host "    [5] Exit" -ForegroundColor White
        Write-Host ""
        $menuChoice = Read-Host "  Select an option (1-5)"

        switch ($menuChoice) {
            "1" {
                Clear-Host
                Show-Report -Result $result -Root $Path -MaxDisplayRows $MaxDisplayRows
            }
            "2" {
                try {
                    $content = Get-Content -Path $exportedFile -Raw
                    $content | Set-Clipboard
                    Write-Host "  [OK] Report copied to clipboard." -ForegroundColor Green
                } catch {
                    Write-Host "  [ERROR] Could not copy to clipboard: $($_.Exception.Message)" -ForegroundColor Red
                }
            }
            "3" {
                $newFile = Export-Report -Result $result -Root $Path
                Write-Host "  [OK] Report exported to: $newFile" -ForegroundColor Green
            }
            "4" {
                try {
                    Add-Type -AssemblyName System.Windows.Forms
                    Add-Type -AssemblyName System.Drawing
                    $screen = [System.Windows.Forms.SystemInformation]::VirtualScreen
                    $bmp = New-Object System.Drawing.Bitmap $screen.Width, $screen.Height
                    $gfx = [System.Drawing.Graphics]::FromImage($bmp)
                    $gfx.CopyFromScreen($screen.Left, $screen.Top, 0, 0, $bmp.Size)
                    $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
                    $shotFile = Join-Path (Get-Location).Path "Screenshot_$timestamp.png"
                    $bmp.Save($shotFile)
                    $gfx.Dispose()
                    $bmp.Dispose()
                    Write-Host "  [OK] Screenshot saved to: $shotFile" -ForegroundColor Green
                } catch {
                    Write-Host "  [ERROR] Failed to capture screenshot: $($_.Exception.Message)" -ForegroundColor Red
                }
            }
            "5" {
                Write-Host "  Exiting..." -ForegroundColor Gray
            }
            default {
                Write-Host "  Invalid choice, please pick 1-5." -ForegroundColor Red
            }
        }
    } while ($menuChoice -ne "5")

} catch {
    Write-Host "  [ERROR] $_" -ForegroundColor Red
    Write-Host $_.ScriptStackTrace -ForegroundColor DarkGray
} finally {
    Stop-BackgroundMusic
    Write-Host ""
    Write-Host "  Press any key to exit..."
    $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
}
</file>

<file path="DirectoryInspector#.bat">
@echo off
setlocal EnableDelayedExpansion

:: ============================================================================
::  DIRECTORY INSPECTOR — with Error Tracking
:: ============================================================================

echo [1] Script started.
pause

set "NOCOLOR=0"
if /i "%~1"=="/nocolor" set "NOCOLOR=1"

:: ---- Try to enable ANSI colors ----
if "%NOCOLOR%"=="0" (
    for /f %%E in ('echo prompt $E^|cmd') do set "ESC=%%E"
)
if defined ESC (
    set "RST=%ESC%[0m"
    set "CYN=%ESC%[1;36m"
    set "MAG=%ESC%[1;35m"
    set "GRN=%ESC%[1;32m"
    set "YLW=%ESC%[1;33m"
    set "RED=%ESC%[1;31m"
    set "GRY=%ESC%[90m"
    set "WHT=%ESC%[1;37m"
) else (
    set "RST=" & set "CYN=" & set "MAG=" & set "GRN="
    set "YLW=" & set "RED=" & set "GRY=" & set "WHT="
)

echo [2] Colors set.
pause

set "ROOT=%cd%"
set "LINE=+----------------------------------------------------------------------------+"

:: ---- temp workspace ----
set "TMP=%TEMP%\dirinspect_%RANDOM%"
mkdir "%TMP%" >nul 2>&1
set "F_EMPTYDIR=%TMP%\emptydirs.txt"
set "F_EMPTYFILE=%TMP%\emptyfiles.txt"
set "F_CODEFILE=%TMP%\codefiles.txt"
set "REPORTFILE=%TMP%\DirectoryReport.txt"
type nul > "%F_EMPTYDIR%" 2>nul
type nul > "%F_EMPTYFILE%" 2>nul
type nul > "%F_CODEFILE%" 2>nul

echo [3] Temp files created at %TMP%
pause

set /a totalFolders=0
set /a emptyFolders=0
set /a totalFiles=0
set /a emptyFiles=0
set /a codeFiles=0
set /a totalLines=0
set "EXTLIST="

cls
echo %CYN%%LINE%
echo ^|                          D I R E C T O R Y   I N S P E C T O R             ^|
echo %LINE%%RST%
echo %GRY%  Root : %ROOT%%RST%
echo %GRY%  Scanning recursively, please wait...%RST%
echo.

echo [4] Starting folder scan...
pause

:: =========================================================================
:: SCAN FOLDERS
:: =========================================================================
for /f "delims=" %%D in ('dir /ad /b /s "%ROOT%" 2^>nul') do (
    set /a totalFolders+=1
    set "hasContent="
    for /f "delims=" %%Z in ('dir /b "%%D" 2^>nul') do set "hasContent=1"
    if not defined hasContent (
        set /a emptyFolders+=1
        set "rel=%%D"
        set "rel=!rel:%ROOT%\=!"
        echo !rel!>>"%F_EMPTYDIR%"
    )
)

echo [5] Folder scan complete. Found %totalFolders% folders.
pause

:: =========================================================================
:: SCAN FILES
:: =========================================================================
for /f "delims=" %%F in ('dir /a-d /b /s "%ROOT%" 2^>nul') do (
    set /a totalFiles+=1
    set "sz=%%~zF"
    set "rel=%%F"
    set "rel=!rel:%ROOT%\=!"

    if !sz! EQU 0 (
        set /a emptyFiles+=1
        echo !rel!>>"%F_EMPTYFILE%"
    ) else (
        set "lines=0"
        for /f %%L in ('find /c /v "" ^< "%%F" 2^>nul') do set "lines=%%L"
        set /a codeFiles+=1
        set /a totalLines+=lines

        set "ext=%%~xF"
        if "!ext!"=="" (
            set "extDisp=(none)"
            set "extKey=noext"
        ) else (
            set "extDisp=!ext!"
            set "extKey=!ext:~1!"
        )

        echo !extDisp!^|!sz!^|!lines!^|!rel!>>"%F_CODEFILE%"

        if not defined CNT_!extKey! (
            set "EXTLIST=!EXTLIST! !extKey!^|!extDisp!"
        )
        set /a "CNT_!extKey!+=1"
        set /a "LN_!extKey!+=lines"
    )
)

echo [6] File scan complete. Found %totalFiles% files.
pause

echo %GRY%  Scan complete.%RST%
echo.

:: =========================================================================
:: SUMMARY
:: =========================================================================
echo %CYN%%LINE%
echo ^|                                  S U M M A R Y                             ^|
echo %LINE%%RST%
call :printStat "Total folders scanned"    !totalFolders!
call :printStat "Empty folders found"      !emptyFolders!
call :printStat "Total files scanned"      !totalFiles!
call :printStat "Empty files found"        !emptyFiles!
call :printStat "Files with content"       !codeFiles!
call :printStat "Total lines (all files)"  !totalLines!
echo.

echo [7] Summary displayed.
pause

:: =========================================================================
:: EMPTY FOLDERS
:: =========================================================================
echo %RED%%LINE%
echo ^|                              E M P T Y   F O L D E R S                     ^|
echo %LINE%%RST%
if !emptyFolders! EQU 0 (
    echo %GRN%  [OK] No empty folders found.%RST%
) else (
    for /f "usebackq delims=" %%A in ("%F_EMPTYDIR%") do (
        echo %RED%  [EMPTY DIR]%RST%  %%A
    )
)
echo.

:: =========================================================================
:: EMPTY FILES
:: =========================================================================
echo %RED%%LINE%
echo ^|                               E M P T Y   F I L E S                        ^|
echo %LINE%%RST%
if !emptyFiles! EQU 0 (
    echo %GRN%  [OK] No empty files found.%RST%
) else (
    for /f "usebackq delims=" %%A in ("%F_EMPTYFILE%") do (
        echo %RED%  [EMPTY FILE]%RST% %%A
    )
)
echo.

:: =========================================================================
:: FILES WITH CONTENT
:: =========================================================================
echo %GRN%%LINE%
echo ^|                       F I L E S   W I T H   C O N T E N T                  ^|
echo %LINE%%RST%
if !codeFiles! EQU 0 (
    echo %YLW%  No files with content found.%RST%
) else (
    call :printTableHeader
    for /f "usebackq tokens=1,2,3* delims=|" %%A in ("%F_CODEFILE%") do (
        call :printFileRow "%%D" "%%A" "%%B" "%%C"
    )
)
echo.

:: =========================================================================
:: BREAKDOWN BY EXTENSION
:: =========================================================================
echo %MAG%%LINE%
echo ^|                       B R E A K D O W N   B Y   E X T E N S I O N          ^|
echo %LINE%%RST%
if not defined EXTLIST (
    echo %YLW%  No extension data available.%RST%
) else (
    call :padstr "EXTENSION" 14
    set "eh1=!PAD!"
    call :padstr "FILES" 10
    set "eh2=!PAD!"
    echo %WHT%  !eh1!!eh2!LINES%RST%
    echo %GRY%  --------------------------------------------------------------------%RST%
    for %%X in (!EXTLIST!) do (
        for /f "tokens=1,2 delims=|" %%K in ("%%X") do (
            call :padstr "%%L" 14
            set "ec1=!PAD!"
            call :padstr "!CNT_%%K!" 10
            set "ec2=!PAD!"
            echo %MAG%  !ec1!!ec2!!LN_%%K!%RST%
        )
    )
)
echo.
echo %CYN%%LINE%%RST%
echo %GRY%  Finished scanning "%ROOT%"%RST%
echo.

echo [8] Results displayed.
pause

:: =========================================================================
:: BUILD REPORT FILE
:: =========================================================================
call :BuildReportFile

echo [9] Report built.
pause

:: =========================================================================
:: OPTIONS MENU
:: =========================================================================
:MENU
echo %CYN%%LINE%
echo ^|                                  O P T I O N S                             ^|
echo %LINE%%RST%
echo %WHT%   [1]%RST% View the report again on screen
echo %WHT%   [2]%RST% Copy the report to clipboard
echo %WHT%   [3]%RST% Export the report as a .txt file
echo %WHT%   [4]%RST% Take a screenshot of this window
echo %WHT%   [5]%RST% Exit
echo.
set "choice="
set /p "choice=  Select an option (1-5): "

if "%choice%"=="1" goto VIEW_REPORT
if "%choice%"=="2" goto COPY_REPORT
if "%choice%"=="3" goto EXPORT_REPORT
if "%choice%"=="4" goto SCREENSHOT
if "%choice%"=="5" goto CLEANUP

echo %RED%  Invalid choice, please pick 1-5.%RST%
echo.
goto MENU

:VIEW_REPORT
cls
type "%REPORTFILE%"
echo.
pause
echo.
goto MENU

:COPY_REPORT
clip < "%REPORTFILE%"
echo %GRN%  [OK] Report copied to clipboard.%RST%
echo.
goto MENU

:EXPORT_REPORT
set "outname=DirectoryReport_%RANDOM%.txt"
copy /y "%REPORTFILE%" "%~dp0!outname!" >nul
echo %GRN%  [OK] Report exported to: %~dp0!outname!%RST%
echo.
goto MENU

:SCREENSHOT
set "shotfile=%~dp0Report_Screenshot_%RANDOM%.png"
echo %GRY%  Capturing screenshot in 2 seconds - bring this window to front...%RST%
powershell -NoProfile -Command "Start-Sleep -Seconds 2; Add-Type -AssemblyName System.Windows.Forms,System.Drawing; $b=[System.Windows.Forms.SystemInformation]::VirtualScreen; $bmp=New-Object System.Drawing.Bitmap $b.Width,$b.Height; $g=[System.Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($b.Left,$b.Top,0,0,$bmp.Size); $bmp.Save('%shotfile%'); $g.Dispose(); $bmp.Dispose();" 2>nul
if exist "%shotfile%" (
    echo %GRN%  [OK] Screenshot saved to: %shotfile%%RST%
) else (
    echo %RED%  [FAIL] Screenshot could not be taken.%RST%
)
echo.
goto MENU

:CLEANUP
rd /s /q "%TMP%" >nul 2>&1
echo.
echo %GRY%  Temporary files cleaned up.%RST%
echo %GRY%  Press any key to exit...%RST%
pause >nul
endlocal
goto :EOF

:: =========================================================================
:: SUBROUTINES
:: =========================================================================

:BuildReportFile
(
echo ================================================================================
echo                        DIRECTORY INSPECTOR REPORT
echo ================================================================================
echo Root scanned : %ROOT%
echo Generated    : %date% %time%
echo.
echo --------------------------------------------------------------------------
echo SUMMARY
echo --------------------------------------------------------------------------
echo Total folders scanned    : %totalFolders%
echo Empty folders found      : %emptyFolders%
echo Total files scanned      : %totalFiles%
echo Empty files found        : %emptyFiles%
echo Files with content       : %codeFiles%
echo Total lines ^(all files^) : %totalLines%
echo.
echo --------------------------------------------------------------------------
echo EMPTY FOLDERS
echo --------------------------------------------------------------------------
) >> "%REPORTFILE%"

if !emptyFolders! EQU 0 (
    echo No empty folders found.>>"%REPORTFILE%"
) else (
    for /f "usebackq delims=" %%A in ("%F_EMPTYDIR%") do echo [EMPTY DIR]  %%A>>"%REPORTFILE%"
)

(
echo.
echo --------------------------------------------------------------------------
echo EMPTY FILES
echo --------------------------------------------------------------------------
) >> "%REPORTFILE%"

if !emptyFiles! EQU 0 (
    echo No empty files found.>>"%REPORTFILE%"
) else (
    for /f "usebackq delims=" %%A in ("%F_EMPTYFILE%") do echo [EMPTY FILE] %%A>>"%REPORTFILE%"
)

(
echo.
echo --------------------------------------------------------------------------
echo FILES WITH CONTENT
echo --------------------------------------------------------------------------
) >> "%REPORTFILE%"

if !codeFiles! EQU 0 (
    echo No files with content found.>>"%REPORTFILE%"
) else (
    for /f "usebackq tokens=1,2,3* delims=|" %%A in ("%F_CODEFILE%") do (
        call :humanSize "%%B"
        echo   %%D  ^|  ext:%%A  ^|  size:!HSIZE!  ^|  lines:%%C>>"%REPORTFILE%"
    )
)

(
echo.
echo --------------------------------------------------------------------------
echo BREAKDOWN BY EXTENSION
echo --------------------------------------------------------------------------
) >> "%REPORTFILE%"

if not defined EXTLIST (
    echo No extension data.>>"%REPORTFILE%"
) else (
    for %%X in (!EXTLIST!) do (
        for /f "tokens=1,2 delims=|" %%K in ("%%X") do (
            echo   %%L  -  files: !CNT_%%K!   lines: !LN_%%K!>>"%REPORTFILE%"
        )
    )
)

(
echo.
echo ================================================================================
echo End of report.
) >> "%REPORTFILE%"
goto :eof

:printStat
call :padstr "%~1" 32
echo %WHT%  !PAD!: %CYN%%~2%RST%
goto :eof

:printTableHeader
call :padstr "FILE PATH" 50
set "h1=!PAD!"
call :padstr "EXT" 9
set "h2=!PAD!"
call :padstr "SIZE" 10
set "h3=!PAD!"
echo %WHT%  !h1!!h2!!h3!LINES%RST%
echo %GRY%  --------------------------------------------------------------------------%RST%
goto :eof

:printFileRow
set "p=%~1"
set "xt=%~2"
set "bz=%~3"
set "ln=%~4"

call :humanSize "%bz%"
set "hsz=!HSIZE!"

call :padstr "%p%" 50
set "c1=!PAD!"
call :padstr "%xt%" 9
set "c2=!PAD!"
call :padstr "%hsz%" 10
set "c3=!PAD!"

echo %GRN%  !c1!%GRY%!c2!%YLW%!c3!%CYN%%ln%%RST%
goto :eof

:humanSize
setlocal
set /a b=%~1
if !b! GEQ 1048576 (
    set /a mb=!b!/1048576
    set "res=!mb! MB"
) else if !b! GEQ 1024 (
    set /a kb=!b!/1024
    set "res=!kb! KB"
) else (
    set "res=!b! B"
)
endlocal & set "HSIZE=%res%"
goto :eof

:padstr
setlocal
set "s=%~1"
set "w=%~2"
set "s=!s!                                                                                  "
set "s=!s:~0,%w%!"
endlocal & set "PAD=%s%"
goto :eof
</file>

<file path="Echo_Engine_Implementation_Roadmap.md">
# Echo Engine → Echoes of Tomorrow — Implementation Roadmap

*A build-order roadmap derived from the EDD's own dependency chain, repository structure, and "game-and-engine co-evolve" philosophy.*

---

## 0. How this roadmap was derived

The EDD already tells you the correct build order — it's just spread across three places instead of stated as one plan:

- **Chapter 1** says the game and engine must evolve together, and that nothing should be built before the game demands it.
- **Chapter 4** gives an explicit dependency chain: `Game → Scene Runtime → World → Assets → Framework`, with the rule that dependencies only flow downward.
- **Chapter 6** establishes that the World System, not the Three.js scene graph, is the source of truth — which means World must exist *before* Rendering is treated as anything more than a dumb consumer.

A "perfect" roadmap for a project this size isn't one that builds all 25 chapters in document order — it's one that gets a *thin, vertical slice* playable as early as possible, then thickens each layer in the same order the dependency graph demands. That's the structure below.

**Reality check first:** what's specified across these 25 chapters — a custom spatial pipeline, VAT-based crowd animation, HAOS hardware adaptation, a full editor, networking, save/versioning, and a shippable deployment pipeline — is engine-team-sized work (historically 15–40 engineers over 2–4 years for comparable scope). This roadmap doesn't shrink the scope; it sequences it so a small team (or solo dev) always has something running, instead of spending a year on infrastructure with nothing to show. Treat every phase below as "build the minimum that unblocks the next phase," not "fully implement the chapter."

---

## 1. Phase Map (dependency-ordered)

```
Phase 0   Repo, tooling, engineering standards
Phase 1   Framework core + Diagnostics bootstrap        (Ch. 3, 4, 5, 24)
Phase 2   ECS core                                       (Ch. 7)
Phase 3   World System + Matrix Spatial Pipeline          (Ch. 6)
Phase 4   Scene Runtime (D013)                            (Ch. 4 §8)
Phase 5   Asset System + Import Pipeline                  (Ch. 9, 10)
Phase 6   Minimal Rendering (consumer of World, not owner) (Ch. 11)
Phase 7   Input System                                    (Ch. 22)
   ── MILESTONE A: "Grey-box playable" ──
Phase 8   Physics & Collision                             (Ch. 15)
Phase 9   Animation + VAT pipeline                        (Ch. 12)
Phase 10  Audio System                                    (Ch. 17)
Phase 11  AI & Navigation                                 (Ch. 16)
Phase 12  Streaming & World Partition                     (Ch. 14)
Phase 13  Scripting & Gameplay Framework                  (Ch. 19)
Phase 14  UI/UX Framework                                 (Ch. 21)
Phase 15  Persistence & Save System                       (Ch. 23)
   ── MILESTONE B: "Vertical slice" ──
Phase 16  HAOS (hardware-adaptive optimization)            (Ch. 13)
Phase 17  Editor & Developer Toolchain                     (Ch. 20)
   ── MILESTONE C: "Content-ready pipeline" ──
Phase 18  Full production of Echoes of Tomorrow (content)
Phase 19  Networking & Multiplayer (only if the game needs it) (Ch. 18)
Phase 20  Security, Packaging & Deployment                 (Ch. 25)
   ── MILESTONE D: "Shippable" ──
Phase 21  Forge Engine extraction
```

Rendering deliberately sits at Phase 6, *after* World and Asset foundations — not because visuals don't matter, but because Chapter 6's whole argument is that rendering must stay a downstream consumer. Building it first is exactly the trap the EDD says to avoid.

---

## 2. Phase 0 — Repo, Tooling, Engineering Standards
**Unblocks everything. ~2–4 weeks.**

- Scaffold the repo layout from Chapter 4 §2 (`framework/ ecs/ world/ scene/ assets/ rendering/ animation/ streaming/ physics/ audio/ input/ scripting/ networking/ ui/ utilities/ diagnostics/ editor/ resources/ game/`) even for directories that stay empty for months — it enforces the dependency-flow rule (Ch. 4 §3) from day one via lint/CI rather than convention.
- TypeScript project setup, module boundaries enforced (e.g. dependency-cruiser or a custom ESLint rule that fails the build on an upward import).
- CI pipeline skeleton: build, typecheck, unit test, lint — this becomes the foundation Phase 20's Build Automation (Ch. 21 in Deployment chapter) extends later, so don't rebuild it twice.
- Write down the "Architecture Before Implementation" workflow (Ch. 3 §4.1: propose → review → freeze → implement → integration review → merge) as an actual lightweight RFC template, even if you're a team of one — it's what turns "design philosophy" into something you actually follow under deadline pressure.

**Exit criteria:** empty engine boots, CI is green, module-boundary violations fail the build automatically.

---

## 3. Phase 1 — Framework Core + Diagnostics Bootstrap
**~3–5 weeks.**

Build only what Chapter 4 §4 assigns to Framework: app startup/shutdown, main loop, frame lifecycle, service registration, event dispatch, scheduler integration — plus a minimal slice of the Diagnostics Framework (Ch. 24) bootstrapped *now*, not deferred to Phase 20.

Why diagnostics this early, out of document order: almost every later chapter (Asset System, Streaming, HAOS, Deployment) assumes structured logging/metrics already exist and just hooks into them. Building it last means retrofitting instrumentation into 20 finished subsystems instead of building 20 subsystems that were observable from day one.

**Exit criteria:** a service can register with the framework, the main loop ticks at a stable frame rate, and a basic log/metrics stream is visible in a dev console.

---

## 4. Phase 2 — ECS Core
**~3–4 weeks.**

Implement entities/components/systems per Chapter 7: sparse-set storage, contiguous component arrays, system scheduling. Keep it strictly ignorant of rendering, audio, UI, and networking, exactly as Chapter 4 §5 mandates — that discipline is what makes Phase 19 (networking) tractable later, since the EDD's own justification for ECS is component-level replication.

**Exit criteria:** you can create/destroy thousands of entities, attach components, and run a system over them with measurable, stable frame time.

---

## 5. Phase 3 — World System + Matrix Spatial Pipeline
**~4–6 weeks. This is the architectural crux of the whole engine.**

Per Chapter 6: `Transform.js`, `SectorID`, `CellID`, local/sector/world coordinate transforms, and a world hierarchy that is deliberately *not* the Three.js scene graph. Get this wrong and every downstream system (rendering, physics, AI, streaming, save) inherits the mistake, since they all consume this layer.

**Exit criteria:** you can place, query, and transform objects across sector boundaries with correct coordinate math, with zero dependency on any renderer.

---

## 6. Phase 4 — Scene Runtime (D013)
**~2–3 weeks.**

Chapter 4 §8 scopes this precisely: scene lifecycle, transitions, active camera, environment, scene load/unload — orchestration, not simulation ownership. The EDD notes this was historically one of the first fully-merged subsystems in the project's own narrative, which lines up with putting it early here: it's the thin coordination layer everything above World needs before Assets and Rendering have anywhere to plug in.

**Exit criteria:** you can load/unload a scene, switch active camera, and tear down cleanly without leaks.

---

## 7. Phase 5 — Asset System + Import Pipeline
**~5–7 weeks.**

Chapter 9's separation is the important part to preserve, not skip for speed: `AssetRegistry` (metadata) / `AssetCache` (loaded resources) / `AssetLoader` (loading) / `AssetManager` (coordination), plus specialised loaders (Texture, Model, Shader, Audio, Video, Material, Font). Pair with the Import Pipeline (Ch. 10) so raw content can flow into engine-ready descriptors without hand-editing.

**Exit criteria:** a texture and a model can be requested by handle, loaded asynchronously, reference-counted, and evicted — with the Diagnostics layer from Phase 1 showing load times and cache hit rates.

---

## 8. Phase 6 — Minimal Rendering
**~5–7 weeks for a first working renderer; ongoing after that.**

Only now does Three.js integration begin, and strictly as described in Chapter 6: a *consumer* of World data, not its owner. Start with the smallest useful slice — camera, basic PBR material, one light type, frustum-culled draw calls sourced from World queries. Don't build "modern lighting techniques" (Ch. 8) yet; that's iteration, not foundation.

**Exit criteria:** the World System's contents render correctly and stay in sync as entities move, with rendering code containing zero authoritative world-state.

---

## 9. Phase 7 — Input System
**~2 weeks.**

Chapter 22's device abstraction, kept deliberately small at this stage (keyboard/mouse, one gamepad profile). This is what turns a rendered world into something a person can actually stand in and move through.

---

### ── Milestone A: "Grey-box playable" ──
A single test level: framework running, ECS-driven entities, correct spatial math, assets loading, basic rendering, and player input — walkable, first-person, no gameplay yet. This is the first point where the "engine and game co-evolve" philosophy from Chapter 1 can start operating for real: from here on, build features because *Echoes of Tomorrow* needs them, not because the document lists them.

---

## 10. Phases 8–15 — Systems Layer (parallelizable if team size allows)

These can run roughly in parallel once Milestone A lands, because they're mostly siblings in the dependency graph rather than a strict chain — but sequence them by what your first real gameplay scenario actually needs:

| Phase | System | Chapter | Notes |
|---|---|---|---|
| 8 | Physics & Collision | 15 | Needed before AI navigation and before any real gameplay feel |
| 9 | Animation + VAT pipeline | 12 | High-value but genuinely hard; start with CPU skeletal fallback, add VAT baking once you have >1 animated character type to justify it |
| 10 | Audio System | 17 | Environmental acoustics can wait; basic spatial audio can't |
| 11 | AI & Navigation | 16 | Depends on Physics (Ch. 15) and World (Ch. 6) both being stable |
| 12 | Streaming & World Partition | 14 | Only becomes urgent once your test level exceeds trivial size — don't over-build this before you have a world big enough to need it |
| 13 | Scripting & Gameplay Framework | 19 | This is where "Echoes of Tomorrow"-specific logic starts living, separate from engine code |
| 14 | UI/UX Framework | 21 | HUD and menus needed for anything beyond a tech demo |
| 15 | Persistence & Save System | 23 | Build once your world/entity schemas have stabilized — building it earlier means constant migration churn |

**Guardrail:** resist the pull to gold-plate any one of these before the others exist. A common failure mode on projects like this is polishing VAT animation or HAOS for months while the game has no save system, no AI, and no UI — leaving nothing playable end-to-end.

---

### ── Milestone B: "Vertical slice" ──
One real level of *Echoes of Tomorrow*, playable start to finish: physics-driven movement, animated enemies/NPCs, spatial audio, basic AI behavior, a save/load cycle, and real UI. This is the milestone that validates the entire architecture under Chapter 1's "real-world validation" principle — if something in the World/ECS/Asset foundation is wrong, it surfaces here, while it's still cheap to fix.

---

## 11. Phase 16 — HAOS (Hardware-Adaptive Optimization)
**~4–6 weeks, and only after Milestone B.**

Chapter 13's hardware-adaptive system needs real workload data to tune against — CPU/GPU/RAM profiles from an actual playable slice, not theoretical budgets. Building HAOS before you have a vertical slice to profile means guessing at thresholds you'll have to redo anyway.

---

## 12. Phase 17 — Editor & Developer Toolchain
**~6–10 weeks, can start once World/Asset/Scene are stable (i.e., can begin in parallel with Phase 8–15, but finishing it is only worth prioritizing once content production is about to scale).**

Chapter 20's tooling pays for itself the moment you have more than one person building levels, or more content than fits in hand-written data files. If you're solo through Milestone B, a minimal in-engine debug UI is enough; invest in the full editor once content production (Phase 18) is about to begin in earnest.

---

### ── Milestone C: "Content-ready pipeline" ──
HAOS is tuning quality automatically across at least two different hardware tiers, and the editor/toolchain is good enough that adding a new level doesn't require touching engine code.

---

## 13. Phase 18 — Full Content Production
This is where most of the remaining calendar time goes for *Echoes of Tomorrow* specifically — level design, narrative content, the "cyberpunk + Indian cultural identity" world-building called out in Chapter 1, enemy/NPC variety, audio content, localization data (Ch. 25 §15). Engine work becomes reactive from here: fix what content production reveals as broken or missing, rather than driving new architecture speculatively.

---

## 14. Phase 19 — Networking & Multiplayer *(conditional)*
Chapter 18 is explicitly framed elsewhere in the EDD as "future" work, and Chapter 7 notes the ECS's component-level design supports it *when needed*. Don't build this unless *Echoes of Tomorrow*'s actual design calls for multiplayer — if it's single-player, skip straight to Phase 20 and let Forge Engine inherit this as a later, generalized feature instead.

---

## 15. Phase 20 — Security, Packaging & Deployment
**~4–6 weeks.**

Chapter 25's VFS, package manifests, integrity verification, patch system, platform abstraction. This is late by design: packaging architecture is easiest to get right once you know what's actually shipping, and it reuses the CI foundation from Phase 0 rather than inventing a parallel pipeline.

---

### ── Milestone D: "Shippable" ──
A verified, patchable, platform-packaged build of *Echoes of Tomorrow* that a player outside the dev team can install and run.

---

## 16. Phase 21 — Forge Engine Extraction
Only after Echo Engine has actually shipped a game (Ch. 1 §2, "Only after the engine matures through real-world use..."). Extraction work: identify which parts of World/ECS/Asset/Rendering are genuinely game-agnostic versus load-bearing assumptions specific to *Echoes of Tomorrow*, and split accordingly. Doing this earlier means generalizing against guesses instead of evidence — exactly what Chapter 1 warns against.

---

## 17. Risk Register

| Risk | Where it bites | Mitigation |
|---|---|---|
| Scope creep via document-order building | Any phase | Always ask "does the current vertical slice need this" before extending a subsystem past its milestone's exit criteria |
| Over-engineering HAOS/VAT before there's data | Phase 9, 16 | Both are explicitly sequenced after a playable milestone in this roadmap for that reason |
| Rendering re-absorbing world ownership | Phase 6 onward | Enforce via the Phase 0 lint rule — no upward imports from `rendering/` into `world/` |
| Small team, 25-chapter scope | Whole project | Track against milestones (A–D), not chapters; a milestone slipping is real signal, a chapter being "incomplete" is expected at almost every point before Phase 18 |
| Save/serialization churn | Phase 15 | Deliberately deferred until schemas stabilize post-Milestone A |
| Editor investment before it's needed | Phase 17 | Minimal debug tooling until content production actually demands more |

---

## 18. Rough Timeline (order-of-magnitude, not a commitment)

Assuming the "architecture-first, review-driven" process in Chapter 3 is followed rather than skipped under pressure:

- **Solo developer:** Milestone A ≈ 4–6 months · Milestone B ≈ 10–14 months · Milestone D (shippable, modest-scope game) ≈ 2.5–4 years
- **Small team (4–6, mixed engine/gameplay):** Milestone A ≈ 2–3 months · Milestone B ≈ 5–7 months · Milestone D ≈ 12–20 months

These ranges assume Phase 18 (content) is scoped to a real, bounded game rather than an open-ended AAA world — the single biggest lever on total timeline is how large *Echoes of Tomorrow*'s actual content scope ends up being, which is a game-design decision, not an engine one.

---

*This roadmap sequences the EDD's existing 25 chapters by dependency and playability rather than proposing new architecture. Chapter/section references throughout point back to the source document for the authoritative technical detail.*
