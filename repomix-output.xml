     *
     * @param {number} angle - Rotation angle in radians
     * @returns {this} For method chaining
     */
    rotateZ(angle) {
        const halfAngle = angle * 0.5;
        const q = new Quaternion(0, 0, Math.sin(halfAngle), Math.cos(halfAngle));
        this.multiply(q);
        return this;
    }

    // ============================================================
    // Interpolation
    // ============================================================

    /**
