    this.sectorId = options.sectorId || null;
    this.dependencies = Object.freeze([...(options.dependencies ?? [])]);
    this.validatorIds = Object.freeze([...(options.validatorIds ?? [])]);
    this.state = EventState.CREATED;
  }

