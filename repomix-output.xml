                        Invoke-SystemSound -Type Error
                        Start-Sleep -Seconds 2
                    }
                }
                '6' {
                    Clear-Host
                    Show-FloatingBar
                    Invoke-Chatbot
                    Clear-Host
                }
                '7' {
