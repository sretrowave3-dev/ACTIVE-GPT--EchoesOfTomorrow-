    isRegistered(id) { return this._registry.has(id); }

    /** @returns {string[]} */
    getRegisteredSceneIds() { return Array.from(this._registry.keys()); }

    /**
     * Private helper to fully shut down a scene.
     * @param {Scene} scene
     * @private
