import { EntitySignature } from '../EntitySignature.js';

export class MovementSystem extends System {
  constructor() {
    super();
    this.priority = 100;
    this._requiredSig = new EntitySignature();
    /** @private */
    this._transformId = -1;
    this._velocityId = -1;
  }

