Step 4: Create the Engine Entry Point
Inside your new src folder, create a file named main.js. This is the new brain of the application. It will orchestrate the renderer, the player controls, and the active scene.

--- 

// src/main.js
// As the project scales, this file simply acts as the traffic controller.

let renderer, camera, currentScene;
let lastTime = performance.now();

function initEngine() {
    console.log("⚙️ System Core Initializing...");
    
    const canvas = document.getElementById('gameCanvas');
    
    // 1. Setup Global Renderer
    renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping; 
    renderer.toneMappingExposure = 1.0;

    // 2. Setup Global Camera
    camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 1000);

    // Window Resizing Logic
    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // TODO: Initialize Game State Manager here in the next step
    console.log("⚙️ Awaiting Scene Manager...");
}

function gameLoop() {
    requestAnimationFrame(gameLoop);
    const time = performance.now();
    const delta = (time - lastTime) / 1000;
    
    // Update active scene and physics if they exist
    if (currentScene && currentScene.update) {
        currentScene.update(delta, time);
        renderer.render(currentScene.scene, camera);
    }
    
    lastTime = time;
}

// Start the core engine
initEngine();
gameLoop();


