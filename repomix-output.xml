<file path="src/framework/core/GameClock.js">
export class GameClock {
    constructor() {
        this.lastTimestamp = 0;
        this.deltaTime = 0;
        this.elapsedTime = 0;
        this.frameCount = 0;
    }

    tick(timestamp) {
        if (typeof timestamp !== 'number' || Number.isNaN(timestamp)) {
            throw new TypeError('GameClock.tick expects a numeric timestamp');
        }

        if (this.lastTimestamp === 0) {
            this.deltaTime = 0;
        } else {
            this.deltaTime = Math.max(0, (timestamp - this.lastTimestamp) / 1000);
        }

        this.lastTimestamp = timestamp;
        this.elapsedTime += this.deltaTime;
        this.frameCount += 1;

        return this.deltaTime;
    }

    get deltaTimeSeconds() {
        return this.deltaTime;
    }

    get elapsedTimeSeconds() {
        return this.elapsedTime;
    }

    get frameCountValue() {
        return this.frameCount;
    }
}
</file>

<file path="src/framework/core/ServiceRegistry.js">
export class ServiceRegistry {
  constructor() {
    this._services = new Map();
  }

  register(name, service) {
    if (this._services.has(name)) {
      throw new Error(`ServiceRegistry already contains a service named '${name}'.`);
    }
    this._services.set(name, service);
  }

  get(name) {
    return this._services.get(name);
  }

  async initializeAll() {
    for (const service of this._services.values()) {
      if (typeof service.initialize === 'function') {
        await service.initialize();
      }
    }
  }

  async startAll() {
    for (const service of this._services.values()) {
      if (typeof service.start === 'function') {
        await service.start();
      }
    }
  }

  async shutdownAll() {
    for (const service of this._services.values()) {
      if (typeof service.shutdown === 'function') {
        await service.shutdown();
      }
    }
  }
}
</file>

