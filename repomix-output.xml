        const f = forward.clone().normalize();
        const u = up.clone().normalize();
        const r = u.clone().cross(f).normalize();
        const newUp = f.clone().cross(r).normalize();

        // Build rotation matrix from basis vectors (column-major)
        const m = [
            r.x, newUp.x, f.x, 0,
            r.y, newUp.y, f.y, 0,
            r.z, newUp.z, f.z, 0,
            0, 0, 0, 1
