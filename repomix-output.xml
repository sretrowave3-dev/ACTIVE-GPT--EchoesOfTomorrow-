    this._enabled = true;
    this.priority = 0;   // lower number executes first
  }

  /**
   * Called once when the system is registered.
   * @param {import('./ECSManager.js').ECSManager} ecs
   */
  initialize(ecs) {
    // override if needed
  }

  /**
   * Per-frame update. Receives an array of matching entity IDs.
