)

# Duplicate base intents to reach 100 total intents
$allIntents = @()
while ($allIntents.Count -lt 100) {
    foreach ($base in $baseIntents) {
        if ($allIntents.Count -ge 100) { break }
        $newName = $base.Name + "_" + ($allIntents.Count + 1)
        $allIntents += [PSCustomObject]@{
            Name = $newName
            Patterns = $base.Patterns
            Responses = $base.Responses
        }
    }
}

$totalIntents = $allIntents.Count
Write-Host "Total intents: $totalIntents" -ForegroundColor Gray

$patternsPerIntent = 30000
$responsesPerIntent = 30000

Write-Host "Generating $patternsPerIntent patterns and $responsesPerIntent responses per intent..." -ForegroundColor Gray
Write-Host "This will take 15-30 minutes. Progress will be shown." -ForegroundColor Yellow
Write-Host ""

function ConvertTo-JsonString {
    param([string]$String)
    $String = $String -replace "\\", "\\" -replace '"', '\"' -replace "`n", "\n" -replace "`r", "\r" -replace "`t", "\t"
    return $String
}

# ---- Create file stream ----
$utf8NoBom = New-Object System.Text.UTF8Encoding $false
$stream = [System.IO.File]::OpenWrite($OutputPath)
$writer = New-Object System.IO.StreamWriter($stream, $utf8NoBom)

Write-Host "Writing JSON to $OutputPath..." -ForegroundColor Cyan

$writer.Write("{`n")
$writer.Write('  "meta": {')
$writer.Write('    "version": "2.0.0",')
$writer.Write('    "generated": "' + (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ") + '",')
$writer.Write('    "total_intents": ' + $totalIntents + ',')
$writer.Write('    "total_patterns": ' + ($totalIntents * $patternsPerIntent) + ',')
$writer.Write('    "total_responses": ' + ($totalIntents * $responsesPerIntent) + ',')
$writer.Write('    "description": "Massive conversation database (500 MB)"')
$writer.Write("  },")
$writer.Write('  "intents": {')
$writer.Write("")

$intentIndex = 0
foreach ($intent in $allIntents) {
    $intentIndex++
    $percent = [math]::Round(($intentIndex / $totalIntents) * 100, 0)
    Write-Progress -Activity "Generating JSON" -Status "Writing intent $intentIndex of $totalIntents ($percent%)" -PercentComplete $percent

    if ($intentIndex -gt 1) { $writer.Write(",") }
    $writer.Write("`n    `"$($intent.Name)`": {")
    $writer.Write("`n      `"patterns`": [")

    for ($i = 0; $i -lt $patternsPerIntent; $i++) {
        if ($i -gt 0) { $writer.Write(",") }
        $basePattern = $intent.Patterns | Get-Random
        $variant = "$basePattern (pattern $i) - Echo Engine v8.0"
        $escaped = ConvertTo-JsonString -String $variant
        $writer.Write("`n        `"$escaped`"")
    }
    $writer.Write("`n      ],")

    $writer.Write("`n      `"responses`": [")
    for ($i = 0; $i -lt $responsesPerIntent; $i++) {
        if ($i -gt 0) { $writer.Write(",") }
        $baseResponse = $intent.Responses | Get-Random
        $variant = "$baseResponse (response $i) - Echo Engine v8.0"
        $escaped = ConvertTo-JsonString -String $variant
        $writer.Write("`n        `"$escaped`"")
    }
    $writer.Write("`n      ]")
    $writer.Write("`n    }")
}

$writer.Write("`n  }")
$writer.Write("`n}")

$writer.Close()
$stream.Close()

$fileSize = (Get-Item $OutputPath).Length / 1MB
$rounded = [math]::Round($fileSize, 2)
Write-Host "Done! Generated $OutputPath ($rounded MB)" -ForegroundColor Green
</file>

<file path="Generate-HeavyNarrator.ps1">
<#
.SYNOPSIS
    Generates a heavy (≈100MB) narrator_data.json file by expanding entries.
.DESCRIPTION
    Reads a base narrator_data.json (if exists) and multiplies arrays by repetition
    with random variations to reach a large file size.
.PARAMETER OutputPath
    Path where the heavy JSON will be saved (default: narrator_data_heavy.json)
.PARAMETER TargetSizeMB
    Approximate target file size in MB (default: 100)
#>

param(
    [string]$OutputPath = "narrator_data_heavy.json",
    [int]$TargetSizeMB = 100
)

Write-Host "Generating heavy narrator JSON..." -ForegroundColor Cyan

# Load base data (if exists)
$baseFile = Join-Path $PSScriptRoot "narrator_data.json"
if (Test-Path $baseFile) {
    Write-Host "  Loading base narrator_data.json..." -ForegroundColor Gray
    $baseJson = Get-Content $baseFile -Raw -Encoding UTF8 | ConvertFrom-Json
} else {
    Write-Host "  Base file not found. Creating minimal structure..." -ForegroundColor Yellow
    $baseJson = [PSCustomObject]@{
        intro_phrases = @("Loading file for analysis.")
        extension_narratives = @{ default = "Generic file type detected." }
        size_descriptions = @{ tiny = "Tiny file." }
        trivia_database = @{ default = @("Files store data.") }
        outro_phrases = @("Analysis complete.")
    }
}

# Helper to expand an array
function Expand-Array {
    param(
        [object[]]$Original,
        [int]$TargetCount
    )
    $result = @()
    $index = 0
    while ($result.Count -lt $TargetCount) {
        foreach ($item in $Original) {
            $variant = "$item [v$index]"
            $result += $variant
            $index++
            if ($result.Count -ge $TargetCount) { break }
        }
    }
    return $result
}

Write-Host "  Expanding intro_phrases to 10,000 entries..." -ForegroundColor Gray
$expandedIntro = Expand-Array -Original $baseJson.intro_phrases -TargetCount 10000

Write-Host "  Expanding extension_narratives..." -ForegroundColor Gray
$newExt = @{}
foreach ($key in $baseJson.extension_narratives.PSObject.Properties.Name) {
    $baseText = $baseJson.extension_narratives.$key
    $expanded = ""
    for ($i = 0; $i -lt 5000; $i++) {
        $variant = "$baseText (variant $i)"
        $expanded += $variant + " "
    }
    $newExt[$key] = $expanded.Trim()
}
if (-not $newExt.ContainsKey("default")) {
    $newExt["default"] = ("Default extension description. " * 1000)
}

Write-Host "  Expanding size_descriptions..." -ForegroundColor Gray
$newSize = @{}
foreach ($key in $baseJson.size_descriptions.PSObject.Properties.Name) {
    $baseText = $baseJson.size_descriptions.$key
    $newSize[$key] = "$baseText " * 100
}

Write-Host "  Expanding trivia_database..." -ForegroundColor Gray
$newTrivia = @{}
foreach ($key in $baseJson.trivia_database.PSObject.Properties.Name) {
    $baseList = $baseJson.trivia_database.$key
    $expandedList = @()
    $count = 0
    while ($expandedList.Count -lt 2000) {
        foreach ($item in $baseList) {
            $newItem = "$item (fact $count)"
            $expandedList += $newItem
            $count++
            if ($expandedList.Count -ge 2000) { break }
        }
    }
    $newTrivia[$key] = $expandedList
}

Write-Host "  Expanding outro_phrases to 5,000 entries..." -ForegroundColor Gray
$expandedOutro = Expand-Array -Original $baseJson.outro_phrases -TargetCount 5000

Write-Host "  Building final JSON object..." -ForegroundColor Gray
$heavy = [PSCustomObject]@{
    intro_phrases        = $expandedIntro
    extension_narratives = $newExt
    size_descriptions    = $newSize
    trivia_database      = $newTrivia
    outro_phrases        = $expandedOutro
}

Write-Host "  Converting to JSON..." -ForegroundColor Gray
$json = $heavy | ConvertTo-Json -Depth 10

Write-Host "  Saving to $OutputPath..." -ForegroundColor Gray
$json | Out-File -FilePath $OutputPath -Encoding UTF8

$fileSize = (Get-Item $OutputPath).Length / 1MB
Write-Host "Done! Generated heavy JSON: $OutputPath ($([math]::Round($fileSize,2)) MB)" -ForegroundColor Green
</file>

<file path="Generate-Synonyms.ps1">
<#
.SYNOPSIS
    Generates a massive synonyms.json file (~500 MB) with artificial synonym mappings.
.DESCRIPTION
    Creates a JSON object with 200,000 entries, each with 50 synonyms.
    Used to feed the Echo Engine narrator for vocabulary variation.
.PARAMETER OutputPath
    Path to save the generated JSON file.
#>

param(
    [string]$OutputPath = "synonyms.json"
)

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "  500 MB SYNONYMS GENERATOR" -ForegroundColor Green
Write-Host "  This will take 10-20 minutes. Please be patient." -ForegroundColor Yellow
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host ""

# ---- Base synonym templates ----
$baseWords = @(
    "good", "bad", "happy", "sad", "big", "small", "fast", "slow", "hot", "cold",
    "bright", "dark", "light", "heavy", "soft", "hard", "smooth", "rough", "clear", "vague",
    "true", "false", "real", "fake", "strong", "weak", "deep", "shallow", "wide", "narrow",
    "high", "low", "long", "short", "thick", "thin", "rich", "poor", "young", "old",
    "new", "old", "modern", "ancient", "simple", "complex", "easy", "hard", "safe", "dangerous",
    "sure", "unsure", "known", "unknown", "open", "closed", "full", "empty", "alive", "dead",
    "awake", "asleep", "calm", "wild", "quiet", "loud", "peaceful", "violent", "kind", "cruel",
    "wise", "foolish", "brave", "cowardly", "proud", "humble", "gentle", "rough", "friendly", "hostile"
)

$synonymPool = @(
    "synonym", "alternative", "variant", "equivalent", "parallel", "analog", "substitute",
    "replacement", "option", "choice", "counterpart", "match", "twin", "clone", "copy"
)

# ---- Expand base words to 200,000 entries ----
$wordList = @()
$desiredCount = 200000
$multiplier = [math]::Ceiling($desiredCount / $baseWords.Count)
for ($i = 0; $i -lt $multiplier; $i++) {
    foreach ($word in $baseWords) {
        if ($wordList.Count -ge $desiredCount) { break }
        $wordList += "$word_$i"
    }
}

$totalEntries = $wordList.Count
Write-Host "Total entries: $totalEntries" -ForegroundColor Gray

# ---- Streaming JSON writer ----
$utf8NoBom = New-Object System.Text.UTF8Encoding $false
$stream = [System.IO.File]::OpenWrite($OutputPath)
$writer = New-Object System.IO.StreamWriter($stream, $utf8NoBom)

Write-Host "Writing JSON to $OutputPath..." -ForegroundColor Cyan

$writer.Write("{`n")
$writer.Write('  "synonym_map": {')
$writer.Write("")

$entryIndex = 0
foreach ($word in $wordList) {
    $entryIndex++
    $percent = [math]::Round(($entryIndex / $totalEntries) * 100, 0)
    if ($entryIndex % 1000 -eq 0) {
        Write-Progress -Activity "Generating JSON" -Status "Writing entry $entryIndex of $totalEntries ($percent%)" -PercentComplete $percent
    }

    if ($entryIndex -gt 1) { $writer.Write(",") }
    $writer.Write("`n    `"$word`": [")

    # Generate 50 synonyms per word
    for ($i = 0; $i -lt 50; $i++) {
        if ($i -gt 0) { $writer.Write(",") }
        $baseSyn = $synonymPool | Get-Random
        $synonym = "${baseSyn}_${word}_$i"
        # Escape any double quotes
        $escaped = $synonym -replace '"', '\"'
        $writer.Write("`n      `"$escaped`"")
    }
    $writer.Write("`n    ]")
}

$writer.Write("`n  }")
$writer.Write("`n}")

$writer.Close()
$stream.Close()

$fileSize = (Get-Item $OutputPath).Length / 1MB
$rounded = [math]::Round($fileSize, 2)
Write-Host "Done! Generated $OutputPath ($rounded MB)" -ForegroundColor Green
</file>

