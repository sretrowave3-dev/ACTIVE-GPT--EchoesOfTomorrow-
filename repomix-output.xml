  remove(eventId) {
    const index = this._events.findIndex(e => e.id === eventId);
    if (index !== -1) {
      this._events.splice(index, 1);
      this._idMap.delete(eventId);
    }
  }

  clear() {
    this._events.length = 0;
    this._idMap.clear();
