   */
  get sceneManager() {
    return this._sceneManager;
  }

  /** @override */
  async shutdown() {
    if (this._sceneManager) {
      const current = this._sceneManager.current();
      if (current) {
        current.stop();
        current.unload();
        current.destroy();
      }
      this._sceneManager = null;
    }
  }
