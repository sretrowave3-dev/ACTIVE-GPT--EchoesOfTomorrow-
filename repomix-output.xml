<file path="EchoSync/src/EventCoalescer.cpp">
#include "../include/EventCoalescer.hpp"
#include "../include/Logger.hpp"

namespace EchoSync {

EventCoalescer::EventCoalescer(std::chrono::milliseconds coalesceWindow)
    : m_coalesceWindow(coalesceWindow) {}

void EventCoalescer::PushRawEvent(const FileSystemEvent& rawEvent) {
    std::lock_guard<std::mutex> lock(m_mutex);

    // Handle Rename pairing: OLD_NAME + NEW_NAME
    if (rawEvent.action == FileAction::Rename && rawEvent.oldActiveRelPath.empty()) {
        // Step 1 of Rename: storing OLD name
        m_pendingRenameOld = rawEvent;
        return;
    }

    FileSystemEvent eventToProcess = rawEvent;
    if (eventToProcess.action == FileAction::Rename && !eventToProcess.oldActiveRelPath.empty()) {
        // Step 2 of Rename: paired with NEW name
        m_pendingRenameOld.reset();
    } else if (m_pendingRenameOld.has_value() && eventToProcess.action == FileAction::Move) {
        // Paired rename step
        eventToProcess.oldActiveRelPath = m_pendingRenameOld->activeRelPath;
        m_pendingRenameOld.reset();
    }

    std::wstring keyW = std::wstring(eventToProcess.pairId.begin(), eventToProcess.pairId.end()) + L":" + eventToProcess.activeRelPath;
    uint64_t key = HashPath(keyW);
    auto now = std::chrono::system_clock::now();

    auto it = m_pendingMap.find(key);
    if (it != m_pendingMap.end()) {
        // Coalesce rules
        auto& existing = it->second.event;
        
        if (existing.action == FileAction::Create && eventToProcess.action == FileAction::Modify) {
            // CREATE + MODIFY -> CREATE
            it->second.lastSeen = now;
        } else if (existing.action == FileAction::Create && eventToProcess.action == FileAction::Delete) {
            // CREATE + DELETE -> Net Zero NOP! Erase pending.
            m_pendingMap.erase(it);
            return;
        } else {
            // MODIFY + MODIFY -> Update timestamp
            existing.action = eventToProcess.action;
            it->second.lastSeen = now;
        }
    } else {
        m_pendingMap[key] = PendingEventEntry{
            .event = eventToProcess,
            .firstSeen = now,
            .lastSeen = now
        };
    }

    // Move mature entries from pending map to ready queue
    for (auto mapIt = m_pendingMap.begin(); mapIt != m_pendingMap.end(); ) {
        if (now - mapIt->second.lastSeen >= m_coalesceWindow || mapIt->second.event.action == FileAction::Delete || mapIt->second.event.action == FileAction::Rename) {
            m_readyQueue.push(mapIt->second.event);
            mapIt = m_pendingMap.erase(mapIt);
        } else {
            ++mapIt;
        }
    }

    m_cv.notify_one();
}

std::optional<FileSystemEvent> EventCoalescer::PopCoalescedEvent(std::chrono::milliseconds timeout) {
    std::unique_lock<std::mutex> lock(m_mutex);

    // Flush any pending entries if window elapsed
    auto now = std::chrono::system_clock::now();
    for (auto mapIt = m_pendingMap.begin(); mapIt != m_pendingMap.end(); ) {
        if (now - mapIt->second.lastSeen >= m_coalesceWindow) {
            m_readyQueue.push(mapIt->second.event);
            mapIt = m_pendingMap.erase(mapIt);
        } else {
            ++mapIt;
        }
    }

    if (m_readyQueue.empty()) {
        m_cv.wait_for(lock, timeout, [this]() {
            return !m_readyQueue.empty() || !m_pendingMap.empty();
        });

        // Check again after wait
        now = std::chrono::system_clock::now();
        for (auto mapIt = m_pendingMap.begin(); mapIt != m_pendingMap.end(); ) {
            if (now - mapIt->second.lastSeen >= m_coalesceWindow || !m_readyQueue.empty()) {
                m_readyQueue.push(mapIt->second.event);
                mapIt = m_pendingMap.erase(mapIt);
            } else {
                ++mapIt;
            }
        }
    }

    if (m_readyQueue.empty()) {
        return std::nullopt;
    }

    FileSystemEvent event = m_readyQueue.front();
    m_readyQueue.pop();
    return event;
}

void EventCoalescer::Clear() {
    std::lock_guard<std::mutex> lock(m_mutex);
    m_pendingMap.clear();
    while (!m_readyQueue.empty()) m_readyQueue.pop();
    m_pendingRenameOld.reset();
}

size_t EventCoalescer::PendingCount() const {
    std::lock_guard<std::mutex> lock(m_mutex);
    return m_pendingMap.size() + m_readyQueue.size();
}

} // namespace EchoSync
</file>

<file path="EchoSync/src/HashCache.cpp">
#include "../include/HashCache.hpp"
#include "../include/Logger.hpp"
#include <windows.h>
#include <vector>

namespace EchoSync {

uint64_t HashCache::GetOrComputeHash(const std::wstring& fullPath, const FILETIME& lastWriteTime, uint64_t fileSize) {
    uint64_t pathHash = HashPath(fullPath);

    {
        std::lock_guard<std::mutex> lock(m_mutex);
        auto it = m_hashCache.find(pathHash);
        if (it != m_hashCache.end()) {
            if (it->second.fileSize == fileSize &&
                it->second.lastWriteTime.dwLowDateTime == lastWriteTime.dwLowDateTime &&
                it->second.lastWriteTime.dwHighDateTime == lastWriteTime.dwHighDateTime) {
                return it->second.contentHash; // Fast pass: 0 ms file reopen avoidance!
            }
        }
    }

    // Compute fresh hash
    uint64_t freshHash = ComputeFileHash(fullPath);

    {
        std::lock_guard<std::mutex> lock(m_mutex);
        m_hashCache[pathHash] = CachedHashEntry{
            .lastWriteTime = lastWriteTime,
            .fileSize = fileSize,
            .contentHash = freshHash
        };
    }

    return freshHash;
}

void HashCache::Invalidate(const std::wstring& fullPath) {
    uint64_t pathHash = HashPath(fullPath);
    std::lock_guard<std::mutex> lock(m_mutex);
    m_hashCache.erase(pathHash);
}

void HashCache::Clear() {
    std::lock_guard<std::mutex> lock(m_mutex);
    m_hashCache.clear();
}

uint64_t HashCache::ComputeFileHash(const std::wstring& fullPath) const {
    HANDLE hFile = CreateFileW(
        fullPath.c_str(),
        GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
        NULL,
        OPEN_EXISTING,
        FILE_FLAG_SEQUENTIAL_SCAN,
        NULL
    );

    if (hFile == INVALID_HANDLE_VALUE) {
        return 0;
    }

    constexpr DWORD BUFFER_SIZE = 64 * 1024; // 64 KB chunk
    std::vector<uint8_t> buffer(BUFFER_SIZE);

    uint64_t hash = 14695981039346656037ULL; // 64-bit FNV-1a offset basis
    DWORD bytesRead = 0;

    while (ReadFile(hFile, buffer.data(), BUFFER_SIZE, &bytesRead, NULL) && bytesRead > 0) {
        for (DWORD i = 0; i < bytesRead; ++i) {
            hash ^= static_cast<uint64_t>(buffer[i]);
            hash *= 1099511628211ULL;
        }
    }

    CloseHandle(hFile);
    return hash;
}

} // namespace EchoSync
</file>

<file path="EchoSync/src/HotkeyListener.cpp">
#include "../include/HotkeyListener.hpp"
#include "../include/Logger.hpp"

namespace EchoSync {

HotkeyListener::~HotkeyListener() {
    Stop();
}

bool HotkeyListener::Start(HotkeyCallback callback) {
    if (m_running) return true;

    m_callback = callback;
    m_running = true;
    m_thread = std::jthread([this]() { MessageLoop(); });
    return true;
}

void HotkeyListener::Stop() {
    if (!m_running) return;

    m_running = false;
    if (m_threadId != 0) {
        PostThreadMessage(m_threadId, WM_QUIT, 0, 0);
    }

    if (m_thread.joinable()) {
        m_thread.join();
    }
}

void HotkeyListener::MessageLoop() {
    m_threadId = GetCurrentThreadId();

    // VK_OEM_3 is the ` / ~ key
    BOOL registered = RegisterHotKey(NULL, HOTKEY_ID, MOD_SHIFT, VK_OEM_3);
    if (!registered) {
        DWORD err = GetLastError();
        Logger::Instance().Warning("HotkeyListener", "RegisterHotKey (Shift + `) failed. Error: " + std::to_string(err));
    } else {
        Logger::Instance().Info("HotkeyListener", "Registered Global Hotkey: Shift + `");
    }

    MSG msg;
    while (m_running && GetMessage(&msg, NULL, 0, 0)) {
        if (msg.message == WM_HOTKEY && msg.wParam == HOTKEY_ID) {
            if (m_callback) {
                m_callback();
            }
        }
    }

    if (registered) {
        UnregisterHotKey(NULL, HOTKEY_ID);
    }
}

} // namespace EchoSync
</file>

<file path="EchoSync/src/Logger.cpp">
#include "../include/Logger.hpp"
#include <iomanip>
#include <sstream>
#include <ctime>

namespace EchoSync {

static std::string LogLevelToString(LogLevel level) {
    switch (level) {
        case LogLevel::Debug:    return "DEBUG";
        case LogLevel::Info:     return "INFO ";
        case LogLevel::Warning:  return "WARN ";
        case LogLevel::Error:    return "ERROR";
        case LogLevel::Critical: return "CRIT ";
    }
    return "UNK  ";
}

void Logger::Init(const std::string& logFilePath, size_t ringBufferSize) {
    std::lock_guard<std::mutex> lock(m_mutex);
    if (m_running) return;

    m_logPath = logFilePath;
    m_capacity = ringBufferSize;
    m_ringBuffer.resize(m_capacity);
    m_writeIndex = 0;
    m_readIndex = 0;
    m_count = 0;

    m_logFile.open(m_logPath, std::ios::out | std::ios::app);
    m_running = true;

    m_workerThread = std::jthread([this]() { WorkerLoop(); });
}

void Logger::Shutdown() {
    {
        std::lock_guard<std::mutex> lock(m_mutex);
        if (!m_running) return;
        m_running = false;
    }
    m_cv.notify_all();

    if (m_workerThread.joinable()) {
        m_workerThread.join();
    }

    if (m_logFile.is_open()) {
        m_logFile.flush();
        m_logFile.close();
    }
}

void Logger::Log(LogLevel level, const std::string& tag, const std::string& message, uint64_t durationMs, const std::string& result) {
    LogEntry entry{
        .timestamp = std::chrono::system_clock::now(),
        .level = level,
        .tag = tag,
        .message = message,
        .durationMs = durationMs,
        .result = result
    };

    {
        std::lock_guard<std::mutex> lock(m_mutex);
        if (!m_running) return;

        m_ringBuffer[m_writeIndex] = entry;
        m_writeIndex = (m_writeIndex + 1) % m_capacity;
        if (m_count < m_capacity) {
            m_count++;
        } else {
            // Buffer full, advance read index (overwrite oldest)
            m_readIndex = (m_readIndex + 1) % m_capacity;
        }
    }
    m_cv.notify_one();
}

std::vector<LogEntry> Logger::GetRecentLogs(size_t maxEntries) {
    std::lock_guard<std::mutex> lock(m_mutex);
    std::vector<LogEntry> result;
    if (m_count == 0) return result;

    size_t fetchCount = std::min(maxEntries, m_count);
    result.reserve(fetchCount);

    size_t start = (m_writeIndex + m_capacity - fetchCount) % m_capacity;
    for (size_t i = 0; i < fetchCount; ++i) {
        size_t idx = (start + i) % m_capacity;
        result.push_back(m_ringBuffer[idx]);
    }
    return result;
}

void Logger::WorkerLoop() {
    while (m_running) {
        std::unique_lock<std::mutex> lock(m_mutex);
        m_cv.wait_for(lock, std::chrono::milliseconds(250), [this]() {
            return m_readIndex != m_writeIndex || !m_running;
        });

        while (m_readIndex != m_writeIndex && m_running) {
            LogEntry entry = m_ringBuffer[m_readIndex];
            m_readIndex = (m_readIndex + 1) % m_capacity;
            lock.unlock();

            // Format log line
            auto timeT = std::chrono::system_clock::to_time_t(entry.timestamp);
            auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(entry.timestamp.time_since_epoch()) % 1000;
            std::tm tmStruct;
            localtime_s(&tmStruct, &timeT);

            std::ostringstream ss;
            ss << "[" << std::put_time(&tmStruct, "%Y-%m-%d %H:%M:%S")
               << "." << std::setfill('0') << std::setw(3) << ms.count() << "] "
               << "[" << LogLevelToString(entry.level) << "] "
               << "[" << entry.tag << "] "
               << entry.message;

            if (entry.durationMs > 0) {
                ss << " (Duration: " << entry.durationMs << "ms)";
            }
            if (!entry.result.empty()) {
                ss << " -> " << entry.result;
            }
            ss << "\n";

            std::string formatted = ss.str();
            if (m_logFile.is_open()) {
                m_logFile << formatted;
                m_logFile.flush();
            }

            lock.lock();
        }
    }
}

} // namespace EchoSync
